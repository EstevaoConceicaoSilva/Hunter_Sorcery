{
  "name": "RobloxProjects",
  "tree": {
    "$className": "DataModel",
  
    
    "ReplicatedStorage": {
      "Shared": {"$path": "src/shared"},
      "Packages": { "$path": "Packages"},
      "Events": {"$path": "src/Events"},
      "GeneralConfigs": { "$path": "src/GeneralConfigs"}
      
    },

    "ServerScriptService": {
      "Server": {"$path": "src/server"},
      "Services": { "$path": "src/Services"},
      "Handlers": { "$path": "src/Handlers"},
      "Configs": { "$path": "src/Configs"}
      
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    
    "StarterGui": {"$path": "src/StarterGui" },
      
    

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}